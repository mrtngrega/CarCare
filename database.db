PRAGMA foreign_keys = ON;

--------------------------------------------------
-- 1. KATAGÓRIE VEĽKOSTÍ VOZIDIEL
--------------------------------------------------
CREATE TABLE vehicle_categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE, -- napr. 'Malé', 'Stredné', 'Veľké / SUV'
    description TEXT
);

--------------------------------------------------
-- 2. ČÍSELNÍK ZNAČIEK A MODELOV (Systémové nastavenie)
--------------------------------------------------
-- Výrobcovia áut (napr. Skoda, Volkswagen, BMW)
CREATE TABLE brands (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

-- konkrétne modely, ktoré už v sebe majú definovanú kategóriu veľkosti
CREATE TABLE car_models (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    brand_id INTEGER NOT NULL,
    model_name TEXT NOT NULL,
    category_id INTEGER NOT NULL, -- Automaticky určuje veľkosť auta
    FOREIGN KEY (brand_id) REFERENCES brands(id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES vehicle_categories(id),
    UNIQUE(brand_id, model_name)
);

--------------------------------------------------
-- 3. POUŽÍVATELIA A ROLE
--------------------------------------------------
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    phone TEXT,
    role TEXT NOT NULL DEFAULT 'customer' CHECK(role IN ('customer', 'admin')),
    loyalty_points INTEGER NOT NULL DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

--------------------------------------------------
-- 4. VOZIDLÁ ZÁKAZNÍKOV (Používateľ vyberá iba z číselníka)
--------------------------------------------------
CREATE TABLE vehicles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    model_id INTEGER NOT NULL,    -- Odkaz na konkrétny model z číselníka
    license_plate TEXT NOT NULL, -- EČV (napr. BT123AB)
    year INTEGER,                -- Rok výroby (voliteľné)
    color TEXT,                  -- Farba (voliteľné)
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (model_id) REFERENCES car_models(id)
);

--------------------------------------------------
-- 5. DETAILINGOVÉ SLUŽBY A DYNAMICKÝ CENNÍK
--------------------------------------------------
CREATE TABLE services (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    duration_minutes INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE service_prices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    service_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    points_awarded INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (service_id) REFERENCES services(id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES vehicle_categories(id) ON DELETE CASCADE,
    UNIQUE(service_id, category_id)
);

--------------------------------------------------
-- 6. REZERVAČNÝ SYSTÉM
--------------------------------------------------
CREATE TABLE bookings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    vehicle_id INTEGER NOT NULL,
    service_id INTEGER NOT NULL,
    booking_date DATETIME NOT NULL,
    total_price DECIMAL(10, 2) NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending' 
        CHECK(status IN ('pending', 'confirmed', 'completed', 'cancelled')),
    note TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (vehicle_id) REFERENCES vehicles(id),
    FOREIGN KEY (service_id) REFERENCES services(id)
);

--------------------------------------------------
-- 7. VERNOSTNÝ SYSTÉM
--------------------------------------------------
CREATE TABLE loyalty_rewards (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    points_required INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE loyalty_transactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    booking_id INTEGER,
    reward_id INTEGER,
    points INTEGER NOT NULL,
    description TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (booking_id) REFERENCES bookings(id) ON DELETE SET NULL,
    FOREIGN KEY (reward_id) REFERENCES loyalty_rewards(id) ON DELETE SET NULL
);

--------------------------------------------------
-- 8. SÚŤAŽE
--------------------------------------------------
CREATE TABLE contests (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    start_date DATETIME NOT NULL,
    end_date DATETIME NOT NULL,
    prize TEXT NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE contest_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    contest_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    entered_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    is_winner INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (contest_id) REFERENCES contests(id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    UNIQUE(contest_id, user_id)
);
--------------------------------------------------
-- OTVÁRACIE HODINY ŠTÚDIA (Štandardný týždenný plán)
--------------------------------------------------
CREATE TABLE business_hours (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    day_of_week INTEGER NOT NULL CHECK(day_of_week BETWEEN 1 AND 7), -- 1 = Pondelok, 7 = Nedeľa
    open_time TIME NOT NULL,  -- napr. '08:00'
    close_time TIME NOT NULL, -- napr. '17:00'
    max_concurrent_bookings INTEGER NOT NULL DEFAULT 1, -- Koľko áut naraz zvládnu robiť
    is_closed INTEGER NOT NULL DEFAULT 0 -- 1 = zatvorené (napr. cez víkend)
);

--------------------------------------------------
-- VÝNIMKY Z OTVÁRACÍCH HODÍN (Sviatky, dovolenky)
--------------------------------------------------
CREATE TABLE schedule_exceptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    exception_date DATE NOT NULL UNIQUE, -- napr. '2026-12-24'
    is_closed INTEGER NOT NULL DEFAULT 1, -- 1 = celodenné zatvorené
    open_time TIME,  -- Ak sú v tento deň len upravené hodiny
    close_time TIME,
    reason TEXT      -- napr. 'Vianoce', 'Sanitárny deň'
);
--------------------------------------------------
