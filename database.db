-- Zapnutie podpory pre cudzie kľúče (v SQLite predvolene vypnuté)
PRAGMA foreign_keys = ON;

--------------------------------------------------
-- 1. POUŽÍVATELIA A ROLE
--------------------------------------------------
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    first_name TEXT NOT NULL,
    last_name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    phone TEXT,
    role TEXT NOT NULL DEFAULT 'customer' CHECK(role IN ('customer', 'admin')),
    loyalty_points INTEGER NOT NULL DEFAULT 0,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

--------------------------------------------------
-- 2. KATAGÓRIE VEĽKOSTÍ VOZIDIEL
--------------------------------------------------
-- Napr. Small (Hatchback), Medium (Sedan/Combi), Large (SUV/Van)
CREATE TABLE vehicle_categories (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE, -- napr. 'Malé', 'Stredné', 'Veľké / SUV'
    description TEXT
);

--------------------------------------------------
-- 3. VOZIDLÁ ZÁKAZNÍKOV
--------------------------------------------------
CREATE TABLE vehicles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    license_plate TEXT NOT NULL, -- EČV
    brand TEXT NOT NULL,         -- Značka (napr. BMW)
    model TEXT NOT NULL,         -- Model (napr. M3)
    category_id INTEGER NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES vehicle_categories(id)
);

--------------------------------------------------
-- 4. DETAILINGOVÉ SLUŽBY A DYNAMICKÝ CENNÍK
--------------------------------------------------
CREATE TABLE services (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    duration_minutes INTEGER NOT NULL, -- Odhadovaná dĺžka trvania
    is_active INTEGER NOT NULL DEFAULT 1 -- 1 = aktívna, 0 = neaktívna
);

-- Cenník prispôsobený veľkosti vozidla
CREATE TABLE service_prices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    service_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    price DECIMAL(10, 2) NOT NULL,
    points_awarded INTEGER NOT NULL DEFAULT 0, -- Získané vernostné body
    FOREIGN KEY (service_id) REFERENCES services(id) ON DELETE CASCADE,
    FOREIGN KEY (category_id) REFERENCES vehicle_categories(id) ON DELETE CASCADE,
    UNIQUE(service_id, category_id)
);

--------------------------------------------------
-- 5. REZERVAČNÝ SYSTÉM
--------------------------------------------------
CREATE TABLE bookings (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    vehicle_id INTEGER NOT NULL,
    service_id INTEGER NOT NULL,
    booking_date DATETIME NOT NULL,
    total_price DECIMAL(10, 2) NOT NULL,
    status TEXT NOT NULL DEFAULT 'pending' 
        CHECK(status IN ('pending', 'confirmed', 'completed', 'cancelled')),
    note TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (vehicle_id) REFERENCES vehicles(id),
    FOREIGN KEY (service_id) REFERENCES services(id)
);

--------------------------------------------------
-- 6. VERNOSTNÝ SYSTÉM (ODMENY A HISTÓRIA)
--------------------------------------------------
-- Katalóg odmien/bezplatných služieb za body
CREATE TABLE loyalty_rewards (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    points_required INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

-- História získania/čerpania vernostných bodov
CREATE TABLE loyalty_transactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    booking_id INTEGER, -- Môže byť NULL, ak ide o manuálny zásah admina alebo odmenu
    reward_id INTEGER,  -- Použije sa, ak používateľ čerpal body na odmenu
    points INTEGER NOT NULL, -- Kladné číslo = pripísanie, Záporné číslo = čerpanie
    description TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (booking_id) REFERENCES bookings(id) ON DELETE SET NULL,
    FOREIGN KEY (reward_id) REFERENCES loyalty_rewards(id) ON DELETE SET NULL
);

--------------------------------------------------
-- 7. SÚŤAŽE
--------------------------------------------------
CREATE TABLE contests (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    start_date DATETIME NOT NULL,
    end_date DATETIME NOT NULL,
    prize TEXT NOT NULL, -- Výhra/Cena
    is_active INTEGER NOT NULL DEFAULT 1
);

-- Zapojenie používateľov do súťaží
CREATE TABLE contest_entries (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    contest_id INTEGER NOT NULL,
    user_id INTEGER NOT NULL,
    entered_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    is_winner INTEGER NOT NULL DEFAULT 0, -- 1 ak vyhral
    FOREIGN KEY (contest_id) REFERENCES contests(id) ON DELETE CASCADE,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    UNIQUE(contest_id, user_id) -- Používateľ sa môže zapojiť iba raz
);